<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/permRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="アラームの準備"
            android:textColor="@color/forest"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="勤務の日に、画面が消えていても鳴るようにします。下を順にオンにしてください。"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="1. 通知"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="鳴っていることを画面の上に出します。"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/permNotifStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permNotifButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/forest"
            android:text="通知をオンにする"
            android:textColor="@color/card"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. ロック画面"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="スマホがロック中でも、アラームを画面いっぱいに出します。「全画面表示」や「ロック画面」を許可してください。"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/permFullStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permFullButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/forest"
            android:text="ロック画面への表示をオンにする"
            android:textColor="@color/card"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. バッテリー"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="省エネでアラームが遅れないようにします。聞かれたら「許可」、設定なら「制限なし」を選んでください。"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/permBatteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permBatteryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/forest"
            android:text="バッテリーの制限を外す"
            android:textColor="@color/card"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/permExactBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="4. 時刻どおりに鳴らす"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="指定した時刻にぴったり鳴らす許可です。アラームとリマインダーを許可してください。"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/permExactStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/permExactButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/forest"
                android:text="時刻の許可をオンにする"
                android:textColor="@color/card"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="音量ボタンで「アラーム」の音量も上げておいてください。マナーモードでも、アラームの音量は別です。おやすみモードのあいだは鳴らないことがあります。"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/permOpen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/forest"
            android:text="就業を開く"
            android:textColor="@color/card"
            android:textSize="18sp" />

        <Button
            android:id="@+id/permLater"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card"
            android:text="あとでにする"
            android:textColor="@color/forest"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
