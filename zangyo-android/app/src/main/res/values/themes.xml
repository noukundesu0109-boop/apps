<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zangyo" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryDark">@color/forest</item>
        <item name="colorAccent">@color/forest</item>
        <item name="android:statusBarColor">@color/forest</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColor">@color/ink</item>
