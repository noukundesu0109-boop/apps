<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/alarmKicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="アラーム"
        android:textColor="@color/forest"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/alarmClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/alarmVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/card"
        android:gravity="center"
        android:padding="12dp"
        android:text="音量が0です。横のボタンでアラームの音量を上げてください。"
        android:textColor="@color/over"
        android:textSize="16sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarmStop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:backgroundTint="@color/over"
        android:text="止める"
        android:textColor="@color/card"
        android:textSize="22sp" />

    <Button
        android:id="@+id/alarmSnooze"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/forest"
        android:text="5分後にもう一度"
        android:textColor="@color/card"
        android:textSize="22sp" />
</LinearLayout>
